{"id":"jackpot_konosuba","lines":[{"t":0.0,"end":1.89,"chars":[1],"who":"Chris","text":"You and I have a contest","de":"Wir zwei machen jetzt ein Spielchen.","orig":"scenes/jackpot_konosuba/lines/01.mp3"},{"t":1.89,"end":4.09,"chars":[1],"who":"Chris","text":"I stole from you now you steal from me.","de":"Ich hab dich beklaut — jetzt klaust du mich.","orig":"scenes/jackpot_konosuba/lines/02.mp3"},{"t":4.09,"end":5.94,"chars":[1],"who":"Chris","text":"Whatever you get you keep. Deal?","de":"Was du kriegst, gehört dir. Abgemacht?","orig":"scenes/jackpot_konosuba/lines/03.mp3"},{"t":5.94,"end":6.21,"chars":[1],"who":"Chris","text":"*gasp*","de":"*schnapp nach Luft*","orig":"scenes/jackpot_konosuba/lines/04.mp3"},{"t":6.21,"end":8.9,"chars":[1],"who":"Chris","text":"If you're lucky, you might get my magic dager.","de":"Mit Glück erwischst du meinen magischen Dolch.","orig":"scenes/jackpot_konosuba/lines/05.mp3"},{"t":8.9,"end":10.98,"chars":[1],"who":"Chris","text":"It's worth more than 400,000 eris","de":"Der ist über 400.000 Eris wert.","orig":"scenes/jackpot_konosuba/lines/06.mp3"},{"t":10.98,"end":12.06,"chars":[2],"who":"Kazuma","text":"WHOAH. *inhale*","de":"WOAH. *einatmen*","orig":"scenes/jackpot_konosuba/lines/07.mp3"},{"t":12.06,"end":14.15,"chars":[1],"who":"Chris","text":"But if you're unlucky you might get...","de":"Aber wenn du Pech hast, kriegst du …","orig":"scenes/jackpot_konosuba/lines/08.mp3"},{"t":14.15,"end":15.3,"chars":[1],"who":"Chris","text":"These little rocks!","de":"… diese popeligen Steinchen!","orig":"scenes/jackpot_konosuba/lines/09.mp3"},{"t":15.3,"end":17.69,"chars":[2],"who":"Kazuma","text":"H-HEY! THATS NOT FAIR","de":"H-HEY! DAS IST UNFAIR!","orig":"scenes/jackpot_konosuba/lines/10.mp3"},{"t":17.69,"end":18.5,"chars":[1],"who":"Chris","text":"*GIGGLE*","de":"*kicher*","orig":"scenes/jackpot_konosuba/lines/11.mp3"},{"t":18.5,"end":19.54,"chars":[2],"who":"Kazuma","text":"If i get tricked..","de":"Wenn ich reingelegt werde …","orig":"scenes/jackpot_konosuba/lines/12.mp3"},{"t":19.54,"end":22.09,"chars":[2],"who":"Kazuma","text":"I only got myself to blame","de":"… bin ich selber schuld.","orig":"scenes/jackpot_konosuba/lines/13.mp3"},{"t":22.09,"end":23.47,"chars":[2],"who":"Kazuma","text":"YOU GOT IT!","de":"DU HAST ES ERFASST!","orig":"scenes/jackpot_konosuba/lines/14.mp3"},{"t":23.47,"end":26.02,"chars":[2],"who":"Kazuma","text":"Don't cry if i steal something you like!","de":"Heul nicht, wenn ich dir was Liebgewonnenes klaue!","orig":"scenes/jackpot_konosuba/lines/15.mp3"},{"t":26.02,"end":28.1,"chars":[2],"who":"Kazuma","text":"Here I go!","de":"Auf geht's!","orig":"scenes/jackpot_konosuba/lines/16.mp3"},{"t":28.1,"end":32.42,"chars":[2],"who":"Kazuma","text":"STEEEEEEEEAALLL!!","de":"KLAAAAAAUEN!!","orig":"scenes/jackpot_konosuba/lines/17.mp3"},{"t":32.42,"end":35.42,"chars":[1],"who":"Chris","text":"*ngh~~ngh~~*","de":"*ngh~~ngh~~*","orig":"scenes/jackpot_konosuba/lines/18.mp3"},{"t":35.42,"end":38.85,"chars":[2],"who":"Kazuma","text":"YES! let's see what i got.","de":"JA! Mal sehen, was ich hab.","orig":"scenes/jackpot_konosuba/lines/19.mp3"},{"t":38.85,"end":41.86,"chars":[2],"who":"Kazuma","text":"NO WAY! THIS IS BETTER THAN I THOUGHT!!","de":"NIEMALS! DAS IST BESSER, ALS ICH DACHTE!!","orig":"scenes/jackpot_konosuba/lines/20.mp3"},{"t":41.86,"end":43.44,"chars":[2],"who":"Kazuma","text":"*GASP OF HAPPINESS*","de":"*Freudenschnapper*","orig":"scenes/jackpot_konosuba/lines/21.mp3"},{"t":43.44,"end":45.95,"chars":[1],"who":"Chris","text":"*SHOCK WHIMPER?*","de":"*entsetztes Wimmern*","orig":"scenes/jackpot_konosuba/lines/22.mp3"},{"t":45.95,"end":49.22,"chars":[2],"who":"Kazuma","text":"JACK POOOOOOOOT!!","de":"VOLLTREFFEEEEER!!","orig":"scenes/jackpot_konosuba/lines/23.mp3"},{"t":49.22,"end":50.76,"chars":[1],"who":"Chris","text":"GAAAAAAHHH!?!","de":"GAAAAAAHHH!?!","orig":"scenes/jackpot_konosuba/lines/24.mp3"},{"t":50.76,"end":53.81,"chars":[1],"who":"Chris","text":"G-G-GIMME BACK MY PANTIEEES","de":"G-G-GIB MIR MEINEN SCHLÜPFER ZURÜÜÜCK!","orig":"scenes/jackpot_konosuba/lines/25.mp3"},{"t":53.81,"end":54.04,"chars":[2],"who":"Kazuma","text":"AHAHA HAHA WOAH HAHA","de":"AHAHA HAHA WOAH HAHA","orig":"scenes/jackpot_konosuba/lines/26.mp3"},{"t":54.04,"end":55.27,"chars":[1],"who":"Chris","text":"GAAHHHHH * GASP*","de":"GAAHHHHH *keuch*","orig":"scenes/jackpot_konosuba/lines/27.mp3"},{"t":55.27,"end":56.74,"chars":[1],"who":"Chris","text":"THIS ISNT FUNNY KAZUMA!!","de":"DAS IST NICHT WITZIG, KAZUMA!!","orig":"scenes/jackpot_konosuba/lines/28.mp3"},{"t":56.74,"end":56.89,"chars":[2],"who":"Kazuma","text":"WAHHAHAH WAHHHAHAHA","de":"WAHHAHAH WAHHHAHAHA","orig":"scenes/jackpot_konosuba/lines/29.mp3"},{"t":56.89,"end":57.97,"chars":[1],"who":"Chris","text":"C'MON GIVE THEM","de":"JETZT KOMM SCHON, GIB HER!","orig":"scenes/jackpot_konosuba/lines/30.mp3"},{"t":57.97,"end":59.11,"chars":[1],"who":"Chris","text":"WAHHHHH","de":"WAHHHHH","orig":"scenes/jackpot_konosuba/lines/31.mp3"}]}